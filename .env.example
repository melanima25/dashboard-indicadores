# Copie para .env (cp .env.example .env). Valores de DESENVOLVIMENTO local; nenhum segredo real aqui.
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
PORT=3000
NODE_ENV=development
# Chave para gravar importações (header X-Admin-Key). Sem ela só existe a prévia. Em produção, use uma chave longa e aleatória.
ADMIN_KEY=chave-local-de-desenvolvimento
